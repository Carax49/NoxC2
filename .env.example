# ==============================================================================
# NoxC2 Environment Configuration Template
# Sao chép file này thành .env và chỉnh sửa theo nhu cầu:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/Mac)
# ==============================================================================

# ── Server Network Configuration ──────────────────────────────────────────────
# Địa chỉ IP mà Server lắng nghe (0.0.0.0 để lắng nghe tất cả card mạng)
NOX_HOST=127.0.0.1

# Cổng HTTP C2 (dùng cho Agent giao tiếp và Web Dashboard)
NOX_HTTP_PORT=8080

# Cổng TCP nội bộ (legacy/dự phòng)
NOX_PORT=4926

# Timeout kết nối (giây)
NOX_TIMEOUT=5

# ── Security & Authentication Keys ────────────────────────────────────────────
# Secret Key cho Server / Web Dashboard Session (để trống sẽ tự động sinh ngẫu nhiên)
NOX_SECRET_KEY=

# Pre-Shared Key để xác thực Agent (Agent phải có key này mới được kết nối vào C2)
# Để trống ("") nếu muốn tắt tính năng xác thực Agent (mặc định cho lab test)
NOX_AGENT_KEY=nox_agent_secret_token_change_me

# ── HTTPS / TLS Configuration (Roadmap) ───────────────────────────────────────
# Đường dẫn tới SSL Certificate và Private Key (dùng khi chạy HTTPS)
NOX_SSL_CERT=
NOX_SSL_KEY=
